<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.travlediary.repository.post.PostCommentImageMapper">

    <resultMap id="PostCommentImageMap"
               type="com.example.travlediary.model.PostCommentImage">
        <id     property="id"           column="id"/>
        <result property="commentId"    column="comment_id"/>
        <result property="imageUrl"     column="image_url"/>
        <result property="displayOrder" column="display_order"/>
        <result property="createdAt"    column="created_at"/>
    </resultMap>

    <sql id="ImageColumns">
        id, comment_id, image_url, display_order, created_at
    </sql>

    <!-- 사진 1건 저장. display_order 는 1~3 (DB CHECK 제약과 동일) -->
    <insert id="insert" parameterType="com.example.travlediary.model.PostCommentImage"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO post_comment_images (comment_id, image_url, display_order)
        VALUES (#{commentId}, #{imageUrl}, #{displayOrder})
    </insert>

    <!-- 여러 댓글의 사진을 한 번에 조회. 댓글별 display_order 오름차순 -->
    <select id="findByCommentIds" resultMap="PostCommentImageMap">
        SELECT <include refid="ImageColumns"/>
        FROM post_comment_images
        WHERE
        <choose>
            <when test="commentIds != null and commentIds.size() > 0">
                comment_id IN
                <foreach item="commentId" collection="commentIds"
                         open="(" separator="," close=")">
                    #{commentId}
                </foreach>
            </when>
            <otherwise>
                1 = 0
            </otherwise>
        </choose>
        ORDER BY comment_id, display_order
    </select>

</mapper>
