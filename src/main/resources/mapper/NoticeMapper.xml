<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.travlediary.repository.notice.NoticeMapper">

    <resultMap id="NoticeResultMap" type="com.example.travlediary.model.Notice">
        <id property="id" column="id"/>
        <result property="title" column="title"/>
        <result property="content" column="content"/>
        <result property="pinned" column="is_pinned"/>
        <result property="views" column="views"/>
        <result property="userId" column="user_id"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <resultMap id="NoticeListResultMap" type="com.example.travlediary.dto.NoticeListItemDto">
        <id property="id" column="id"/>
        <result property="title" column="title"/>
        <result property="pinned" column="is_pinned"/>
        <result property="views" column="views"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <resultMap id="NoticeDetailResultMap" type="com.example.travlediary.dto.NoticeDetailDto">
        <id property="id" column="id"/>
        <result property="title" column="title"/>
        <result property="content" column="content"/>
        <result property="views" column="views"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <resultMap id="NoticeTranslationResultMap"
               type="com.example.travlediary.model.NoticeTranslation">
        <id property="id" column="id"/>
        <result property="noticeId" column="notice_id"/>
        <result property="languageCode" column="language_code"/>
        <result property="title" column="title"/>
        <result property="content" column="content"/>
    </resultMap>

    <select id="findAdminList" resultMap="NoticeListResultMap">
        SELECT id, title, is_pinned, views, created_at, updated_at
        FROM notices
        ORDER BY is_pinned DESC, created_at DESC, id DESC
    </select>

    <select id="findPublicList" resultMap="NoticeListResultMap">
        SELECT id, title, is_pinned, views, created_at, updated_at
        FROM notices
        ORDER BY is_pinned DESC, created_at DESC, id DESC
        LIMIT #{limit}
        OFFSET #{offset}
    </select>

    <select id="countPublicList" resultType="long">
        SELECT COUNT(*)
        FROM notices
    </select>

    <update id="incrementPublicViews">
        UPDATE notices
        SET views = views + 1,
            updated_at = updated_at
        WHERE id = #{id}
    </update>

    <select id="findPublicDetailById" resultMap="NoticeDetailResultMap">
        SELECT id, title, content, views, created_at
        FROM notices
        WHERE id = #{id}
    </select>

    <select id="findById" resultMap="NoticeResultMap">
        SELECT id, title, content, is_pinned, views, user_id, created_at, updated_at
        FROM notices
        WHERE id = #{id}
    </select>

    <select id="findByIdForUpdate" resultMap="NoticeResultMap">
        SELECT id, title, content, is_pinned, views, user_id, created_at, updated_at
        FROM notices
        WHERE id = #{id}
        FOR UPDATE
    </select>

    <insert id="insertNotice" parameterType="com.example.travlediary.model.Notice"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO notices (title, content, is_pinned, views, user_id)
        VALUES (#{title}, #{content}, #{pinned}, 0, #{userId})
    </insert>

    <update id="updateNotice" parameterType="com.example.travlediary.model.Notice">
        UPDATE notices
        SET title = #{title},
            content = #{content},
            is_pinned = #{pinned}
        WHERE id = #{id}
    </update>

    <delete id="deleteNotice">
        DELETE FROM notices
        WHERE id = #{id}
    </delete>

    <!--
      공지사항 번역. 언어 한 줄이 단위이며 한국어 원문은 notices 가 갖는다.
      공지를 지우면 번역은 FK ON DELETE CASCADE 로 함께 지워지므로 여기서 따로 지우지 않는다.
      언어 대체가 늘 같은 줄을 고르도록 정렬을 고정한다.
    -->
    <select id="findTranslationsByNoticeId" resultMap="NoticeTranslationResultMap">
        SELECT id, notice_id, language_code, title, content
        FROM notice_translations
        WHERE notice_id = #{noticeId}
        ORDER BY language_code ASC, id ASC
    </select>

    <select id="findTranslationsByNoticeIds" resultMap="NoticeTranslationResultMap">
        SELECT id, notice_id, language_code, title, content
        FROM notice_translations
        <choose>
            <when test="noticeIds != null and !noticeIds.isEmpty()">
                WHERE notice_id IN
                <foreach collection="noticeIds" item="noticeId"
                         open="(" separator="," close=")">
                    #{noticeId}
                </foreach>
            </when>
            <otherwise>
                WHERE 1 = 0
            </otherwise>
        </choose>
        ORDER BY notice_id ASC, language_code ASC, id ASC
    </select>

    <insert id="insertTranslation"
            parameterType="com.example.travlediary.model.NoticeTranslation"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO notice_translations (notice_id, language_code, title, content)
        VALUES (#{noticeId}, #{languageCode}, #{title}, #{content})
    </insert>

    <update id="updateTranslation"
            parameterType="com.example.travlediary.model.NoticeTranslation">
        UPDATE notice_translations
        SET title = #{title},
            content = #{content}
        WHERE notice_id = #{noticeId}
          AND language_code = #{languageCode}
    </update>

    <delete id="deleteTranslation">
        DELETE FROM notice_translations
        WHERE notice_id = #{noticeId}
          AND language_code = #{languageCode}
    </delete>

</mapper>
