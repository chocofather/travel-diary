<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.travlediary.repository.user.SocialAccountMapper">

    <resultMap id="SocialAccountResultMap" type="com.example.travlediary.model.SocialAccount">
        <id property="id" column="id"/>
        <result property="userId" column="user_id"/>
        <result property="provider" column="provider"/>
        <result property="providerUserId" column="provider_user_id"/>
        <result property="providerEmail" column="provider_email"/>
        <result property="providerEmailVerified" column="provider_email_verified"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <sql id="SocialAccountColumns">
        id, user_id, provider, provider_user_id, provider_email,
        provider_email_verified, created_at, updated_at
    </sql>

    <select id="findByProviderAndProviderUserId" resultMap="SocialAccountResultMap">
        SELECT <include refid="SocialAccountColumns"/>
        FROM social_accounts
        WHERE provider = #{provider}
          AND provider_user_id = #{providerUserId}
    </select>

    <select id="findByUserIdAndProvider" resultMap="SocialAccountResultMap">
        SELECT <include refid="SocialAccountColumns"/>
        FROM social_accounts
        WHERE user_id = #{userId}
          AND provider = #{provider}
    </select>

    <select id="findAllByUserId" resultMap="SocialAccountResultMap">
        SELECT <include refid="SocialAccountColumns"/>
        FROM social_accounts
        WHERE user_id = #{userId}
        ORDER BY created_at ASC, id ASC
    </select>

    <insert id="insert" parameterType="com.example.travlediary.model.SocialAccount"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO social_accounts (
            user_id, provider, provider_user_id, provider_email, provider_email_verified
        ) VALUES (
            #{userId}, #{provider}, #{providerUserId}, #{providerEmail}, #{providerEmailVerified}
        )
    </insert>

    <delete id="deleteAllByUserId">
        DELETE FROM social_accounts
        WHERE user_id = #{userId}
    </delete>
</mapper>
