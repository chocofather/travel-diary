<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.travlediary.repository.comment.DestinationCommentImageMapper">

    <resultMap id="DestinationCommentImageMap"
               type="com.example.travlediary.model.DestinationCommentImage">
        <id     property="id"           column="id"/>
        <result property="commentId"    column="comment_id"/>
        <result property="imageUrl"     column="image_url"/>
        <result property="displayOrder" column="display_order"/>
        <result property="createdAt"    column="created_at"/>
    </resultMap>

    <sql id="ImageColumns">
        id, comment_id, image_url, display_order, created_at
    </sql>

    <!-- 사진 1건 저장. display_order 는 1~3 (DB CHECK 제약과 동일) -->
    <insert id="insert" parameterType="com.example.travlediary.model.DestinationCommentImage"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO destination_comment_images (comment_id, image_url, display_order)
        VALUES (#{commentId}, #{imageUrl}, #{displayOrder})
    </insert>

    <!-- 여러 댓글의 사진을 한 번에 조회. 댓글별 display_order 오름차순 -->
    <select id="findByCommentIds" resultMap="DestinationCommentImageMap">
        SELECT <include refid="ImageColumns"/>
        FROM destination_comment_images
        WHERE
        <choose>
            <when test="commentIds != null and commentIds.size() > 0">
                comment_id IN
                <foreach item="commentId" collection="commentIds"
                         open="(" separator="," close=")">
                    #{commentId}
                </foreach>
            </when>
            <otherwise>
                1 = 0
            </otherwise>
        </choose>
        ORDER BY comment_id, display_order
    </select>

    <!-- 사진 모아보기. 삭제·관리자 조치된 댓글의 사진은 제외한다. -->
    <select id="findGalleryByDestinationId" resultMap="DestinationCommentImageMap">
        SELECT i.id, i.comment_id, i.image_url, i.display_order, i.created_at
        FROM destination_comment_images i
        JOIN destination_comments c ON c.id = i.comment_id
        WHERE c.destination_id = #{destinationId}
          AND c.deleted = 0
        ORDER BY c.created_at DESC, i.comment_id DESC, i.display_order
        LIMIT #{limit}
    </select>

    <!-- 여행지 삭제 시 파일 정리용. 삭제된 댓글의 사진도 포함하고 개수 제한이 없다. -->
    <select id="findAllImageUrlsByDestinationId" resultType="string">
        SELECT i.image_url
        FROM destination_comment_images i
        JOIN destination_comments c ON c.id = i.comment_id
        WHERE c.destination_id = #{destinationId}
        ORDER BY i.comment_id, i.display_order
    </select>

</mapper>
