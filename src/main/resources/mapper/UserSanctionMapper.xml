<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.travlediary.repository.user.UserSanctionMapper">

    <resultMap id="UserSanctionResultMap" type="com.example.travlediary.model.UserSanction">
        <id property="id" column="id"/>
        <result property="userId" column="user_id"/>
        <result property="type" column="type"/>
        <result property="status" column="status"/>
        <result property="reason" column="reason"/>
        <result property="adminNote" column="admin_note"/>
        <result property="previousStatus" column="previous_status"/>
        <result property="startsAt" column="starts_at"/>
        <result property="expiresAt" column="expires_at"/>
        <result property="releasedAt" column="released_at"/>
        <result property="releasedBy" column="released_by"/>
        <result property="releasedVia" column="released_via"/>
        <result property="releaseReason" column="release_reason"/>
        <result property="createdBy" column="created_by"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <sql id="SanctionColumns">
        id, user_id, type, status, reason, admin_note, previous_status,
        starts_at, expires_at, released_at, released_by, released_via,
        release_reason, created_by, created_at, updated_at
    </sql>

    <insert id="insert" parameterType="com.example.travlediary.model.UserSanction"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO user_sanctions (user_id, type, status, reason, admin_note,
                                    previous_status, starts_at, expires_at, created_by)
        VALUES (#{userId}, #{type}, #{status}, #{reason}, #{adminNote},
                #{previousStatus}, #{startsAt}, #{expiresAt}, #{createdBy})
    </insert>

    <select id="findActiveByUserId" resultMap="UserSanctionResultMap">
        SELECT <include refid="SanctionColumns"/>
        FROM user_sanctions
        WHERE user_id = #{userId}
          AND status = 'ACTIVE'
    </select>

    <select id="findActiveByUserIdForUpdate" resultMap="UserSanctionResultMap">
        SELECT <include refid="SanctionColumns"/>
        FROM user_sanctions
        WHERE user_id = #{userId}
          AND status = 'ACTIVE'
        FOR UPDATE
    </select>

    <select id="findByUserId" resultMap="UserSanctionResultMap">
        SELECT <include refid="SanctionColumns"/>
        FROM user_sanctions
        WHERE user_id = #{userId}
        ORDER BY created_at DESC, id DESC
    </select>

    <select id="findExpiredActiveSanctions" resultMap="UserSanctionResultMap">
        SELECT <include refid="SanctionColumns"/>
        FROM user_sanctions
        WHERE status = 'ACTIVE'
          AND type = 'TEMPORARY'
          AND expires_at IS NOT NULL
          AND expires_at &lt;= #{now}
        ORDER BY expires_at
    </select>

    <update id="release">
        UPDATE user_sanctions
        SET status = #{status},
            released_at = #{releasedAt},
            released_by = #{releasedBy},
            released_via = #{releasedVia},
            release_reason = #{releaseReason}
        WHERE id = #{id}
          AND status = 'ACTIVE'
    </update>

    <!--
      보관기간이 끝난 제재 이력의 조건. 두 갈래다.

      A. 종료된 제재
        status IN ('EXPIRED','LIFTED') : 실제로 끝난 제재만
        released_at IS NOT NULL        : 종료 시각이 남아 있는 기록만
        released_at <= cutoff          : 종료 시각 기준 3년 경과
      기준은 expires_at 이 아니라 released_at 이다. expires_at 은 TEMPORARY 의 예정 종료일이고,
      실제 종료는 만료 배치나 이의신청 인용 시점이라 서로 다를 수 있다. PERMANENT 는 expires_at 이 NULL 이다.
      이미 종료된 제재의 보관기간을 회원의 탈퇴일부터 다시 세지 않는다.

      B. 적용중인 영구제재를 안고 최종 탈퇴한 회원
        type = 'PERMANENT' AND status = 'ACTIVE' : 적용중이라 released_at 이 영원히 NULL 이고,
                                                   A 로는 어떤 시점에도 정리되지 않는다.
        users.status = 'DEACTIVATED'             : 최종 탈퇴가 끝난 tombstone 회원만.
                                                   WITHDRAWAL_PENDING 은 최종 탈퇴가 아니라 제외된다.
        users.deleted_at IS NOT NULL             : 30일 유예 중 복구하면 deleted_at 이 NULL 로
                                                   돌아가 제외된다.
        users.deleted_at <= cutoff               : 최종 탈퇴 완료 시각 기준 3년 경과
      계정이 살아 있는 동안(ACTIVE/RESTRICTED 등)의 영구제재는 이 갈래에 걸리지 않아
      기간 제한 없이 유지된다. 적용중인 임시제재는 두 갈래 어디에도 걸리지 않는다.
    -->
    <sql id="SanctionRetentionExpired">
        (
            (
                s.status IN ('EXPIRED', 'LIFTED')
                AND s.released_at IS NOT NULL
                AND s.released_at &lt;= #{retentionCutoff}
            )
            OR
            (
                s.type = 'PERMANENT'
                AND s.status = 'ACTIVE'
                AND EXISTS (
                    SELECT 1
                    FROM users u
                    WHERE u.id = s.user_id
                      AND u.status = 'DEACTIVATED'
                      AND u.deleted_at IS NOT NULL
                      AND u.deleted_at &lt;= #{retentionCutoff}
                )
            )
        )
        <!--
          재가입 차단이 아직 살아 있으면 제재를 지우지 않고 남겨 둔다. 차단 기록이 sanction_id 를
          잃지 않게 하려는 안전조건이다. A 에서는 정합성이 깨진 상태를 막고,
          B 에서는 blocked_emails 가 같은 기준(users.deleted_at + 3년)으로 먼저 정리된 뒤에야
          제재가 대상이 되도록 순서를 강제한다. 같은 실행 안에서 차단 기록을 먼저 지우므로
          보통 같은 주기에, 그 삭제가 실패하면 다음 주기에 이어서 정리된다.
        -->
        AND NOT EXISTS (
            SELECT 1
            FROM blocked_emails b
            WHERE b.sanction_id = s.id
              AND b.released_at IS NULL
        )
    </sql>

    <!-- B 갈래는 released_at 이 NULL 이라 앞쪽에 온다. id 로 순서가 항상 고정된다. -->
    <select id="findRetentionExpiredSanctionIds" resultType="long">
        SELECT s.id
        FROM user_sanctions s
        WHERE <include refid="SanctionRetentionExpired"/>
        ORDER BY s.released_at, s.id
        LIMIT #{limit}
    </select>

    <!--
      이의신청(user_appeals)은 fk_user_appeals_sanction 의 ON DELETE CASCADE 로 함께 사라진다.
      제재 기록과 한 몸인 증빙이라 수명을 같이 한다.
      blocked_emails.sanction_id 와 user_account_actions.sanction_id 는 ON DELETE SET NULL 이라
      그 행들 자체는 남는다. users tombstone 과 공개 콘텐츠는 이 문장이 건드리지 않는다.
    -->
    <delete id="deleteRetentionExpiredSanction">
        DELETE s
        FROM user_sanctions s
        WHERE s.id = #{id}
          AND <include refid="SanctionRetentionExpired"/>
    </delete>

</mapper>