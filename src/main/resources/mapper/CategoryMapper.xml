<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.travlediary.repository.category.CategoryMapper">

    <resultMap id="CategoryTranslationResultMap"
               type="com.example.travlediary.model.CategoryTranslation">
        <id property="id" column="id"/>
        <result property="categoryId" column="category_id"/>
        <result property="languageCode" column="language_code"/>
        <result property="name" column="name"/>
    </resultMap>

    <select id="findAll" resultType="com.example.travlediary.model.Category">
        SELECT id, name FROM categories
        ORDER BY id
    </select>

    <!-- 여행지 유형별 카테고리 마스터 목록 (category_destination_types 기준) -->
    <select id="findByDestinationType" resultType="com.example.travlediary.model.Category">
        SELECT c.id, c.name
        FROM category_destination_types cdt
                 JOIN categories c ON c.id = cdt.category_id
        WHERE cdt.destination_type = #{destinationType}
        ORDER BY c.id
    </select>

    <!-- 카테고리 ↔ 여행지 유형 마스터 매핑 전체 (화면 필터 태그용) -->
    <select id="findCategoryDestinationTypes"
            resultType="com.example.travlediary.model.CategoryDestinationType">
        SELECT category_id, destination_type
        FROM category_destination_types
        ORDER BY category_id, destination_type
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO categories (name) VALUES (#{name})
    </insert>

    <select id="getCategoryNamesByDestinationId" resultType="String">
        SELECT c.name
        FROM destination_categories dc
                 JOIN categories c ON dc.category_id = c.id
        WHERE dc.destination_id = #{destinationId}
        ORDER BY dc.category_id ASC
    </select>

    <delete id="deleteById" parameterType="long">
        DELETE FROM categories WHERE id = #{id}
    </delete>

    <!-- 단건 카테고리 조회 (수정 화면 복원 / 삭제 대상 확인용) -->
    <select id="findById" parameterType="long" resultType="com.example.travlediary.model.Category">
        SELECT id, name FROM categories WHERE id = #{id}
    </select>

    <select id="findByIds" resultType="com.example.travlediary.model.Category">
        SELECT id, name
        FROM categories
        <choose>
            <when test="categoryIds != null and !categoryIds.isEmpty()">
                WHERE id IN
                <foreach collection="categoryIds" item="categoryId" open="(" separator="," close=")">
                    #{categoryId}
                </foreach>
            </when>
            <otherwise>
                WHERE 1 = 0
            </otherwise>
        </choose>
        ORDER BY id
    </select>

    <select id="findTranslationsByCategoryIds"
            resultMap="CategoryTranslationResultMap">
        SELECT id, category_id, language_code, name
        FROM category_translations
        <choose>
            <when test="categoryIds != null and !categoryIds.isEmpty()">
                WHERE category_id IN
                <foreach collection="categoryIds" item="categoryId" open="(" separator="," close=")">
                    #{categoryId}
                </foreach>
            </when>
            <otherwise>
                WHERE 1 = 0
            </otherwise>
        </choose>
        ORDER BY category_id, language_code, id
    </select>

    <!-- 카테고리 이름 변경 -->
    <update id="update" parameterType="com.example.travlediary.model.Category">
        UPDATE categories
        SET name = #{name}
        WHERE id = #{id}
    </update>

    <!-- name UNIQUE 중복 사전 검사. 수정 시 자기 자신은 제외한다 -->
    <select id="countByNameExcludingId" resultType="int">
        SELECT COUNT(*)
        FROM categories
        WHERE name = #{name}
        <if test="excludeId != null">
            AND id &lt;&gt; #{excludeId}
        </if>
    </select>

    <!-- 카테고리 1건의 적용 가능한 여행지 유형 (수정 화면 체크 복원용) -->
    <select id="findCategoryDestinationTypesByCategoryId"
            resultType="com.example.travlediary.model.CategoryDestinationType">
        SELECT category_id, destination_type
        FROM category_destination_types
        WHERE category_id = #{categoryId}
        ORDER BY destination_type
    </select>

    <!-- 카테고리 ↔ 여행지 유형 매핑 등록. destination_type 은 DestinationType enum 이름 -->
    <insert id="insertCategoryDestinationType">
        INSERT INTO category_destination_types (category_id, destination_type)
        VALUES (#{categoryId}, #{destinationType})
    </insert>

    <!-- 카테고리 1건의 매핑 전체 삭제 (삭제 후 선택값 재삽입용) -->
    <delete id="deleteCategoryDestinationTypesByCategoryId">
        DELETE FROM category_destination_types WHERE category_id = #{categoryId}
    </delete>

    <!-- 실제 여행지 사용 건수. 삭제 차단의 기준이다 -->
    <select id="countDestinationsByCategoryId" parameterType="long" resultType="int">
        SELECT COUNT(*)
        FROM destination_categories
        WHERE category_id = #{categoryId}
    </select>
</mapper>
