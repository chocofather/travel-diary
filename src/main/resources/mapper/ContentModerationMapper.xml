<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.travlediary.repository.moderation.ContentModerationMapper">

    <resultMap id="ContentModerationResultMap"
               type="com.example.travlediary.model.ContentModeration">
        <id property="id" column="id"/>
        <result property="targetType" column="target_type"/>
        <result property="targetId" column="target_id"/>
        <result property="targetUserId" column="target_user_id"/>
        <result property="status" column="status"/>
        <result property="reason" column="reason"/>
        <result property="adminNote" column="admin_note"/>
        <result property="createdBy" column="created_by"/>
        <result property="createdAt" column="created_at"/>
        <result property="restoredAt" column="restored_at"/>
        <result property="restoredBy" column="restored_by"/>
        <result property="restoreReason" column="restore_reason"/>
    </resultMap>

    <!-- 대상 테이블은 enum 화이트리스트로만 결정된다. -->
    <sql id="TargetTable">
        <choose>
            <when test="targetType.name() == 'POST'">user_posts</when>
            <when test="targetType.name() == 'COURSE'">courses</when>
            <when test="targetType.name() == 'POST_COMMENT'">post_comments</when>
            <when test="targetType.name() == 'COURSE_COMMENT'">course_comments</when>
            <when test="targetType.name() == 'DESTINATION_COMMENT'">destination_comments</when>
        </choose>
    </sql>

    <select id="findActiveTargetOwnerId" resultType="java.lang.Long">
        SELECT user_id
        FROM <include refid="TargetTable"/>
        WHERE id = #{targetId}
          AND deleted = 0
    </select>

    <select id="findHiddenTargetOwnerId" resultType="java.lang.Long">
        SELECT user_id
        FROM <include refid="TargetTable"/>
        WHERE id = #{targetId}
          AND deleted = 1
    </select>

    <!-- 관리자 숨김: 사용자 삭제와 달리 user_id 조건이 없다. -->
    <update id="hideTarget">
        UPDATE <include refid="TargetTable"/>
        SET deleted = 1,
            deleted_at = NOW()
        WHERE id = #{targetId}
          AND deleted = 0
    </update>

    <update id="restoreTarget">
        UPDATE <include refid="TargetTable"/>
        SET deleted = 0,
            deleted_at = NULL
        WHERE id = #{targetId}
          AND deleted = 1
    </update>

    <insert id="insert" parameterType="com.example.travlediary.model.ContentModeration"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO content_moderations (target_type, target_id, target_user_id, status,
                                         reason, admin_note, created_by)
        VALUES (#{targetType}, #{targetId}, #{targetUserId}, #{status},
                #{reason}, #{adminNote}, #{createdBy})
    </insert>

    <sql id="ModerationColumns">
        id, target_type, target_id, target_user_id, status, reason, admin_note,
        created_by, created_at, restored_at, restored_by, restore_reason
    </sql>

    <select id="findActiveByTarget" resultMap="ContentModerationResultMap">
        SELECT <include refid="ModerationColumns"/>
        FROM content_moderations
        WHERE target_type = #{targetType}
          AND target_id = #{targetId}
          AND status = 'ACTIVE'
    </select>

    <select id="findActiveByTargetForUpdate" resultMap="ContentModerationResultMap">
        SELECT <include refid="ModerationColumns"/>
        FROM content_moderations
        WHERE target_type = #{targetType}
          AND target_id = #{targetId}
          AND status = 'ACTIVE'
        FOR UPDATE
    </select>

    <select id="findByTarget" resultMap="ContentModerationResultMap">
        SELECT <include refid="ModerationColumns"/>
        FROM content_moderations
        WHERE target_type = #{targetType}
          AND target_id = #{targetId}
        ORDER BY created_at DESC, id DESC
    </select>

    <update id="restoreModeration">
        UPDATE content_moderations
        SET status = 'RESTORED',
            restored_at = #{restoredAt},
            restored_by = #{restoredBy},
            restore_reason = #{restoreReason}
        WHERE id = #{id}
          AND status = 'ACTIVE'
    </update>

</mapper>
