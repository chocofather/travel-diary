<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.travlediary.repository.user.UserPolicyConsentMapper">

    <!--
      동의/거절 결정 한 건. created_at 은 DB 기본값을 쓴다.
      기존 행을 찾아 고치지 않는다. 같은 정책을 다시 결정하면 새 행이 쌓이는 append-only 기록이다.
      locale 과 consent_source 는 DB CHECK 제약이 있는 값이라 서비스가 정규화해서 넘긴다.
    -->
    <insert id="insertConsent" parameterType="com.example.travlediary.model.UserPolicyConsent"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO user_policy_consents
            (user_id, policy_version_id, agreed, locale, consent_source)
        VALUES
            (#{userId}, #{policyVersionId}, #{agreed}, #{locale}, #{consentSource})
    </insert>

    <!--
      보관기간이 끝난 회원의 조건. 세 가지를 모두 만족해야 한다.
        status = 'DEACTIVATED' : 최종 탈퇴가 끝난 tombstone 행
        deleted_at IS NOT NULL : 30일 유예 중 복구한 회원은 deleted_at 이 NULL 로 돌아가 제외된다
        deleted_at <= cutoff   : 최종 탈퇴 완료 시각 기준 3년 경과

      기준은 반드시 deleted_at 이다. withdrawal_requested_at 이나 purge_scheduled_at 으로
      계산하면 유예기간 30일만큼 일찍 지우게 된다.
      ACTIVE/INACTIVE/RESTRICTED/SUSPENDED/WITHDRAWAL_PENDING 은 동의일이 아무리 오래돼도 대상이 아니다.
    -->
    <sql id="ConsentRetentionExpiredUser">
        u.status = 'DEACTIVATED'
        AND u.deleted_at IS NOT NULL
        AND u.deleted_at &lt;= #{retentionCutoff}
    </sql>

    <!-- 동의 이력이 남아 있는 회원만 준다. 이미 정리된 회원을 매번 다시 집지 않는다. -->
    <select id="findConsentRetentionExpiredUserIds" resultType="long">
        SELECT u.id
        FROM users u
        WHERE <include refid="ConsentRetentionExpiredUser"/>
          AND EXISTS (
              SELECT 1
              FROM user_policy_consents c
              WHERE c.user_id = u.id
          )
        ORDER BY u.deleted_at, u.id
        LIMIT #{limit}
    </select>

    <!--
      회원 단위로 전체 삭제한다. 오래된 개별 동의행만 골라 지우지 않는다.
      EXISTS 가 보관기간 조건을 다시 확인하므로, 목록을 읽은 뒤 조건이 깨졌다면 한 행도 지우지 않는다.
      policy_versions / policy_translations 는 참조만 하고 건드리지 않는다.
    -->
    <delete id="deleteConsentsOfRetentionExpiredUser">
        DELETE FROM user_policy_consents
        WHERE user_id = #{userId}
          AND EXISTS (
              SELECT 1
              FROM users u
              WHERE u.id = #{userId}
                AND <include refid="ConsentRetentionExpiredUser"/>
          )
    </delete>

</mapper>
