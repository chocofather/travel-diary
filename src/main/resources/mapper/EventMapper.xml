<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.tripbora.repository.event.EventMapper">

    <!-- DTO: com.tripbora.model.Event -->
    <resultMap id="EventMap" type="com.tripbora.model.Event">
        <id     property="id"        column="id"/>
        <result property="title"     column="title"/>
        <result property="description" column="description"/>
        <result property="eventImg"  column="event_img"/>
        <result property="posterImg" column="poster_img"/>
        <result property="eventType" column="event_type"/>
        <result property="slide" column="is_slide" javaType="boolean"/>
        <result property="userId"    column="user_id"/>
        <result property="startDate" column="start_date"/>
        <result property="endDate"   column="end_date"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <!-- 이벤트 언어별 공개 콘텐츠. 대표 이미지(event_img)는 공용이라 번역 테이블에 없다. -->
    <resultMap id="EventTranslationResultMap"
               type="com.tripbora.model.EventTranslation">
        <id     property="id"          column="id"/>
        <result property="eventId"     column="event_id"/>
        <result property="languageCode" column="language_code"/>
        <result property="title"       column="title"/>
        <result property="description" column="description"/>
        <result property="posterImg"   column="poster_img"/>
    </resultMap>

    <!-- is_slide = 1 인 슬라이드용 이벤트만 가져오기 -->
    <select id="selectSlideEvents" resultMap="EventMap">
        SELECT
            id, title, description, event_img, event_type, is_slide,
            user_id, start_date, end_date, created_at
        FROM events
        WHERE is_slide = 1
          AND start_date &lt;= NOW()
          AND end_date &gt;= NOW()
        ORDER BY id
    </select>


    <!--
      메인 이벤트 프로모션 배너: 메인 노출(is_slide)로 고른 진행 중·진행 예정 이벤트.
      start_date / end_date 는 DATE 라 DB 시계(NOW())와 견주면 종료일 당일 0시 이후에 빠진다.
      그래서 애플리케이션이 넘긴 오늘(KST)과 DATE 끼리 비교한다. 종료일 당일까지 진행 중이다.
        진행 중 : start_date <= today AND end_date >= today  (종료일이 가까운 순)
        진행 예정: start_date > today                        (시작일이 가까운 순)
        종료    : end_date < today                          (빼낸다)
      배너는 대표 이미지(event_img)를 그리므로 이미지가 없는 예전 줄은 뺀다.
    -->
    <select id="selectHomePromotionEvents" resultMap="EventMap">
        SELECT
            id, title, description, event_img, poster_img, event_type, is_slide,
            user_id, start_date, end_date, created_at
        FROM events
        WHERE is_slide = 1
          AND end_date &gt;= #{today}
          AND event_img IS NOT NULL
          AND event_img &lt;&gt; ''
        ORDER BY CASE WHEN start_date &lt;= #{today} THEN 0 ELSE 1 END ASC,
                 CASE WHEN start_date &lt;= #{today} THEN end_date END ASC,
                 CASE WHEN start_date &gt; #{today} THEN start_date END ASC,
                 id ASC
        LIMIT #{limit}
    </select>

    <!-- 새 이벤트 번호는 같은 트랜잭션의 번역 저장에서 쓰므로 돌려받는다. -->
    <insert id="insert"
            parameterType="com.tripbora.model.Event"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO events(title,description,event_img,poster_img,event_type,is_slide,user_id,
                           start_date,end_date,created_at)
        VALUES (#{title},#{description},#{eventImg},#{posterImg},#{eventType},#{slide},#{userId},
                #{startDate},#{endDate},NOW())
    </insert>

    <update id="updateEvent"
            parameterType="com.tripbora.model.Event">
        UPDATE events
        SET title = #{title},
            description = #{description},
            event_img = #{eventImg},
            poster_img = #{posterImg},
            event_type = #{eventType},
            is_slide = #{slide},
            start_date = #{startDate},
            end_date = #{endDate}
        WHERE id = #{id}
    </update>


    <delete id="deleteEventById" parameterType="long">
        DELETE FROM events WHERE id = #{id}
    </delete>

    <!-- 전체 이벤트 (최신순) -->
    <select id="selectAllEvents" resultMap="EventMap">
        SELECT * FROM events ORDER BY start_date DESC
    </select>

    <!-- 진행중 이벤트 -->
    <select id="selectOngoingEvents" resultMap="EventMap">
        SELECT * FROM events
        WHERE start_date &lt;= NOW() AND end_date &gt;= NOW()
        ORDER BY start_date DESC
    </select>

    <!-- 진행예정 이벤트 -->
    <select id="selectUpcomingEvents" resultMap="EventMap">
        SELECT * FROM events
        WHERE start_date &gt; NOW()
        ORDER BY start_date ASC
    </select>

    <!-- 종료된 이벤트 -->
    <select id="selectEndedEvents" resultMap="EventMap">
        SELECT * FROM events
        WHERE end_date &lt; NOW()
        ORDER BY end_date DESC
    </select>

    <!-- 상태별 조건. 상태 값은 서비스에서 ongoing/upcoming/ended 로 정규화된다. -->
    <sql id="StatusCondition">
        <choose>
            <when test="status == 'upcoming'">
                start_date &gt; NOW()
            </when>
            <when test="status == 'ended'">
                end_date &lt; NOW()
            </when>
            <otherwise>
                start_date &lt;= NOW() AND end_date &gt;= NOW()
            </otherwise>
        </choose>
    </sql>

    <!-- 상태별 이벤트 페이지 (정렬 기준은 기존 상태별 목록과 동일) -->
    <select id="selectEventsByStatusPaged" resultMap="EventMap">
        SELECT * FROM events
        WHERE <include refid="StatusCondition"/>
        <choose>
            <when test="status == 'upcoming'">
                ORDER BY start_date ASC
            </when>
            <when test="status == 'ended'">
                ORDER BY end_date DESC
            </when>
            <otherwise>
                ORDER BY start_date DESC
            </otherwise>
        </choose>
        LIMIT #{size} OFFSET #{offset}
    </select>

    <!-- 상태별 전체 개수 (페이지 수 계산용) -->
    <select id="countEventsByStatus" resultType="long">
        SELECT COUNT(*) FROM events
        WHERE <include refid="StatusCondition"/>
    </select>

    <!-- 이벤트 단일조회 (selectEventById) -->
    <select id="selectEventById" resultMap="EventMap" parameterType="long">
        SELECT * FROM events WHERE id = #{id}
    </select>

    <select id="findTranslationsByEventId" parameterType="long"
            resultMap="EventTranslationResultMap">
        SELECT id, event_id, language_code, title, description, poster_img
        FROM event_translations
        WHERE event_id = #{eventId}
        ORDER BY language_code ASC, id ASC
    </select>

    <select id="findTranslationsByEventIds" resultMap="EventTranslationResultMap">
        SELECT id, event_id, language_code, title, description, poster_img
        FROM event_translations
        <choose>
            <when test="eventIds != null and !eventIds.isEmpty()">
                WHERE event_id IN
                <foreach collection="eventIds" item="eventId"
                         open="(" separator="," close=")">
                    #{eventId}
                </foreach>
            </when>
            <otherwise>
                WHERE 1 = 0
            </otherwise>
        </choose>
        ORDER BY event_id ASC, language_code ASC, id ASC
    </select>

    <insert id="insertTranslation"
            parameterType="com.tripbora.model.EventTranslation"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO event_translations (event_id, language_code, title, description, poster_img)
        VALUES (#{eventId}, #{languageCode}, #{title}, #{description}, #{posterImg})
    </insert>

    <!-- event_id 와 language_code 는 대상 줄을 고르는 조건일 뿐 갱신 대상이 아니다. -->
    <update id="updateTranslation"
            parameterType="com.tripbora.model.EventTranslation">
        UPDATE event_translations
        SET title = #{title},
            description = #{description},
            poster_img = #{posterImg}
        WHERE event_id = #{eventId}
          AND language_code = #{languageCode}
    </update>

    <delete id="deleteTranslation">
        DELETE FROM event_translations
        WHERE event_id = #{eventId}
          AND language_code = #{languageCode}
    </delete>
</mapper>
